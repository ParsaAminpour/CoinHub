        "/v1/auth/register": {
            "post": {
                "description": "Register a new user with username, firstname, lastname, and gmail",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Register a new user",
