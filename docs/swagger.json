                "MARKET",
                "STOP_LIMIT",
                "IOC",
                "FOK",
                "POST_ONLY"
            ],
            "x-enum-varnames": [
                "Limit",
                "Market",
                "StopLimit",
                "IOC",
                "FOK",
                "PostOnly"
            ]
        },
        "schema.PlaceOrderRequest": {
            "type": "object",
            "required": [
                "client_ord_id",
                "ord_type",
                "qty",
                "side",
                "symbol",
                "user_id"
            ],
            "properties": {
                "client_ord_id": {
                    "type": "string",
                    "maxLength": 36
                },
                "expire_at": {
                    "type": "string"
                },
                "ord_type": {
                    "enum": [
                        "LIMIT",
                        "MARKET",
                        "STOP_LIMIT",
                        "IOC",
                        "FOK",
                        "POST_ONLY"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/schema.OrdType"
                        }
                    ]
                },
                "price": {
                    "type": "string"
                },
                "qty": {
                    "type": "string"
                },
                "request_id": {
                    "type": "string"
                },
                "side": {
                    "enum": [
                        "BUY",
                        "SELL"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/schema.Side"
                        }
                    ]
                },
                "source": {
                    "type": "string",
                    "enum": [
                        "WEB",
                        "MOBILE",
                        "API"
                    ]
                },
                "stop_price": {
                    "type": "string"
                },
                "symbol": {
                    "description": "e.g. BTC-USDT",
                    "type": "string"
                },
                "time_in_force": {
                    "enum": [
                        "GTC",
                        "GTD",
                        "IOC",
                        "FOK"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/schema.TimeInForce"
                        }
                    ]
                },
                "user_id": {
                    "type": "integer"
                }
            }
        },
