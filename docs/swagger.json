        "schema.TimeInForce": {
            "type": "string",
            "enum": [
                "GTC",
                "GTD",
                "IOC",
                "FOK"
            ],
            "x-enum-comments": {
                "GTC": "Good Till Cancel",
                "GTD": "Good Till Date"
            },
            "x-enum-descriptions": [
                "Good Till Cancel",
                "Good Till Date",
                "",
                ""
            ],
            "x-enum-varnames": [
                "GTC",
                "GTD",
                "TIF_IOC",
                "TIF_FOK"
