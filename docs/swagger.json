            "post": {
                "description": "Handles asset withdrawal requests for native tokens.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transaction"
                ],
                "summary": "Withdraw asset",
